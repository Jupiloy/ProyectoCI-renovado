digraph ER {
graph [bgcolor="white", rankdir=TB, splines=polyline, nodesep=0.36, ranksep=0.68, pad=0.12, outputorder=edgesfirst];
node [shape=plain, fontname="Arial"];
edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.55];
"CHAPTER" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>CHAPTER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD><TD ALIGN="LEFT">number</TD><TD ALIGN="LEFT"><B>&quot;! 1..7&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(20) DEFAULT DRAFT DRAFT|READY|CHANGES_REQUESTED|APPROVED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">approved_revision_id</TD><TD ALIGN="LEFT"><B>FK &quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">approved_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR></TABLE>>];
"CHAPTER_REVISION" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>CHAPTER_REVISION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">chapter_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">revision_no</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">char</FONT></TD><TD ALIGN="LEFT">step_code</TD><TD ALIGN="LEFT"><B>&quot;!(3) P01..P32&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">idempotency_key</TD><TD ALIGN="LEFT"><B>&quot;! UNIQUE(chapter_id, idempotency_key)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">content_md</TD><TD ALIGN="LEFT"><B>&quot;! length&gt;0 snapshot completo&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">char</FONT></TD><TD ALIGN="LEFT">content_sha256</TD><TD ALIGN="LEFT"><B>&quot;!(64)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">created_by_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"REVIEW_COMMENT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>REVIEW_COMMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">revision_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">author_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">start_cp</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">end_cp</TD><TD ALIGN="LEFT"><B>&quot;! &gt;start_cp&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">selected_text</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">body</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(10) DEFAULT OPEN OPEN|RESOLVED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">resolved_by_id</TD><TD ALIGN="LEFT"><B>FK &quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">resolved_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"REVIEW_EVENT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>REVIEW_EVENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">chapter_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">revision_id</TD><TD ALIGN="LEFT"><B>FK &quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT"><B>&quot;!(20) SUBMIT|REQUEST_CHANGES|APPROVE|REOPEN&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"USER" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#17324D"><FONT COLOR="white"><B>USER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR></TABLE>>];
"CHAPTER" -> "CHAPTER_REVISION" [label="versiona\n1 : 0..N", minlen=1];
"CHAPTER" -> "CHAPTER_REVISION" [label="aprueba_actual\n1 : 0..1", minlen=1];
"CHAPTER_REVISION" -> "REVIEW_COMMENT" [label="ancla\n1 : 0..N", minlen=1];
"CHAPTER" -> "REVIEW_EVENT" [label="audita\n1 : 0..N", minlen=1];
"CHAPTER_REVISION" -> "REVIEW_EVENT" [label="objeto\n0..1 : 0..N", minlen=1];
"USER" -> "CHAPTER_REVISION" [label="redacta\n1 : 0..N", minlen=1];
"USER" -> "REVIEW_COMMENT" [label="comenta\n1 : 0..N", minlen=1];
"USER" -> "REVIEW_COMMENT" [label="resuelve\n0..1 : 0..N", minlen=1];
"USER" -> "REVIEW_EVENT" [label="ejecuta\n1 : 0..N", minlen=1];
}
