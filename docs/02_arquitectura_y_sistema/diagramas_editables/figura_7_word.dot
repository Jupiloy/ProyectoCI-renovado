digraph ER {
graph [bgcolor="white", rankdir=TB, splines=polyline, nodesep=0.36, ranksep=0.68, pad=0.12, outputorder=edgesfirst];
node [shape=plain, fontname="Arial"];
edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.55];
"PROJECT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#17324D"><FONT COLOR="white"><B>PROJECT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR></TABLE>>];
"USER" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#17324D"><FONT COLOR="white"><B>USER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR></TABLE>>];
"RESEARCH_VARIABLE" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>RESEARCH_VARIABLE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR></TABLE>>];
"VARIABLE_DIMENSION" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>VARIABLE_DIMENSION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">variable_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD><TD ALIGN="LEFT">ordinal</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><B>&quot;!(200)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">definition</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR></TABLE>>];
"INDICATOR" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>INDICATOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">dimension_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD><TD ALIGN="LEFT">ordinal</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><B>&quot;!(200)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">measurement_scale</TD><TD ALIGN="LEFT"><B>&quot;?(30)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">technique</TD><TD ALIGN="LEFT"><B>&quot;?(120)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">operational_rule</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR></TABLE>>];
"INSTRUMENT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>INSTRUMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">lineage_key</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">version_no</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><B>&quot;!(200)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><B>&quot;!(16) QUESTIONNAIRE|INTERVIEW|FOCUS_GROUP&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">target_population</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(12) DEFAULT DRAFT DRAFT|APPROVED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">approved_by_id</TD><TD ALIGN="LEFT"><B>FK &quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">approved_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"INSTRUMENT_ITEM" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>INSTRUMENT_ITEM</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">instrument_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">dimension_id</TD><TD ALIGN="LEFT"><B>FK &quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD><TD ALIGN="LEFT">ordinal</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">prompt_text</TD><TD ALIGN="LEFT"><B>&quot;! length&gt;0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">response_scale</TD><TD ALIGN="LEFT"><B>&quot;?(120)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">probe_text</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"INSTRUMENT_ITEM_INDICATOR" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>INSTRUMENT_ITEM_INDICATOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">instrument_item_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">indicator_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"RESEARCH_VARIABLE" -> "VARIABLE_DIMENSION" [label="divide\n1 : 0..N", minlen=1];
"VARIABLE_DIMENSION" -> "INDICATOR" [label="mide\n1 : 0..N", minlen=1];
"PROJECT" -> "INSTRUMENT" [label="diseña\n1 : 0..N", minlen=1];
"INSTRUMENT" -> "INSTRUMENT_ITEM" [label="contiene\n1 : 0..N", minlen=1];
"VARIABLE_DIMENSION" -> "INSTRUMENT_ITEM" [label="operacionaliza\n0..1 : 0..N", minlen=1];
"INSTRUMENT_ITEM" -> "INSTRUMENT_ITEM_INDICATOR" [label="mide\n1 : 0..N", minlen=1];
"INDICATOR" -> "INSTRUMENT_ITEM_INDICATOR" [label="se_mide_con\n1 : 0..N", minlen=1];
"USER" -> "INSTRUMENT" [label="aprueba\n0..1 : 0..N", minlen=1];
}
