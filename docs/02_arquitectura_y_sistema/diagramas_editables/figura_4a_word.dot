digraph ER {
graph [bgcolor="white", rankdir=TB, splines=polyline, nodesep=0.36, ranksep=0.68, pad=0.12, outputorder=edgesfirst];
node [shape=plain, fontname="Arial"];
edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.55];
"USER" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#17324D"><FONT COLOR="white"><B>USER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><B>UK &quot;!(254) UNIQUE(lower(email))&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><B>&quot;!(150)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><B>&quot;! DEFAULT true&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"PROJECT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#17324D"><FONT COLOR="white"><B>PROJECT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><B>&quot;!(160)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><B>&quot;!(300)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(12) DEFAULT ACTIVE ACTIVE|ARCHIVED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"PROJECT_PARTICIPANT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>PROJECT_PARTICIPANT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><B>&quot;!(10) OWNER|ADVISOR&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT"><B>&quot;! DEFAULT true&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">joined_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">left_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR></TABLE>>];
"PROJECT_INVITATION" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>PROJECT_INVITATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">created_by_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">invited_email</TD><TD ALIGN="LEFT"><B>&quot;!(254)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><B>&quot;!(10) DEFAULT ADVISOR ADVISOR&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">char</FONT></TD><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT"><B>UK &quot;!(64) UNIQUE&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">accepted_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">revoked_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"USER" -> "PROJECT_PARTICIPANT" [label="participa\n1 : 0..N", minlen=1];
"PROJECT" -> "PROJECT_PARTICIPANT" [label="tiene\n1 : 1..N", minlen=1];
"USER" -> "PROJECT_INVITATION" [label="emite\n1 : 0..N", minlen=1];
"PROJECT" -> "PROJECT_INVITATION" [label="invita\n1 : 0..N", minlen=1];
}
