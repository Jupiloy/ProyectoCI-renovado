digraph ER {
graph [bgcolor="white", rankdir=TB, splines=polyline, nodesep=0.36, ranksep=0.68, pad=0.12, outputorder=edgesfirst];
node [shape=plain, fontname="Arial"];
edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.55];
"PROJECT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#17324D"><FONT COLOR="white"><B>PROJECT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><B>&quot;!(160)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><B>&quot;!(300)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(12) DEFAULT ACTIVE ACTIVE|ARCHIVED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"RESEARCH_PROFILE" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>RESEARCH_PROFILE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>PK &quot;! FK project&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">approach</TD><TD ALIGN="LEFT"><B>&quot;?(16) QUANTITATIVE|QUALITATIVE|MIXED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">topic</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">ods_code</TD><TD ALIGN="LEFT"><B>&quot;?(12)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">unit_of_analysis</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">place</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">period_text</TD><TD ALIGN="LEFT"><B>&quot;?(120)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">problem_statement</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD><TD ALIGN="LEFT">schema_version</TD><TD ALIGN="LEFT"><B>&quot;! DEFAULT 1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">lock_version</TD><TD ALIGN="LEFT"><B>&quot;! DEFAULT 0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"STEP_PROGRESS" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>STEP_PROGRESS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">char</FONT></TD><TD ALIGN="LEFT">step_code</TD><TD ALIGN="LEFT"><B>&quot;!(3) P01..P32&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(16) DEFAULT NOT_STARTED NOT_STARTED|IN_PROGRESS|COMPLETED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">jsonb</FONT></TD><TD ALIGN="LEFT">output_json</TD><TD ALIGN="LEFT"><B>&quot;! DEFAULT {}&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD><TD ALIGN="LEFT">output_schema_version</TD><TD ALIGN="LEFT"><B>&quot;! DEFAULT 1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"CHAPTER" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>CHAPTER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD><TD ALIGN="LEFT">number</TD><TD ALIGN="LEFT"><B>&quot;! 1..7&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(20) DEFAULT DRAFT DRAFT|READY|CHANGES_REQUESTED|APPROVED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">approved_revision_id</TD><TD ALIGN="LEFT"><B>FK &quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">approved_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"PROJECT" -> "RESEARCH_PROFILE" [label="define\n1 : 1", minlen=1];
"PROJECT" -> "STEP_PROGRESS" [label="registra\n1 : 0..N", minlen=1];
"PROJECT" -> "CHAPTER" [label="contiene\n1 : 1..N", minlen=1];
}
