LIGN="LEFT"><B>&quot;? &gt;0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">verification_status</TD><TD ALIGN="LEFT"><B>&quot;!(20) DEFAULT PENDING PENDING|METADATA_CHECKED|TEXT_CHECKED|REJECTED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"SOURCE_EXCERPT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>SOURCE_EXCERPT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid</FONT></TD><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">chunk_no</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=1&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">page_no</TD><TD ALIGN="LEFT"><B>&quot;? &gt;0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">locator</TD><TD ALIGN="LEFT"><B>&quot;?(160)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><B>&quot;! length&gt;0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">char</FONT></TD><TD ALIGN="LEFT">text_sha256</TD><TD ALIGN="LEFT"><B>&quot;!(64)&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"CHAPTER_REVISION" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>CHAPTER_REVISION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">chapter_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR></TABLE>>];
"EVIDENCE_CITATION" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1"><TR><TD COLSPAN="3" BGCOLOR="#1E5A78"><FONT COLOR="white"><B>EVIDENCE_CITATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><B>PK &quot;! auto&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">revision_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">excerpt_id</TD><TD ALIGN="LEFT"><B>FK &quot;!&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">claim_start_cp</TD><TD ALIGN="LEFT"><B>&quot;! &gt;=0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT">claim_end_cp</TD><TD ALIGN="LEFT"><B>&quot;! &gt;claim_start_cp&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT">supporting_quote</TD><TD ALIGN="LEFT"><B>&quot;! length&gt;0&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><B>&quot;!(16) DEFAULT NEEDS_REVIEW NEEDS_REVIEW|VERIFIED|REJECTED&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD><TD ALIGN="LEFT">checked_by_id</TD><TD ALIGN="LEFT"><B>FK &quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">checked_at</TD><TD ALIGN="LEFT"><B>&quot;?&quot;</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><B>&quot;!&quot;</B></TD></TR></TABLE>>];
"PROJECT" -> "SOURCE_DOCUMENT" [label="registra\n1 : 0..N", minlen=1];
"CHAPTER" -> "CHAPTER_REVISION" [label="versiona\n1 : 0..N", minlen=1];
"SOURCE_DOCUMENT" -> "SOURCE_EXCERPT" [label="fragmenta\n1 : 0..N", minlen=1];
"CHAPTER_REVISION" -> "EVIDENCE_CITATION" [label="afirma\n1 : 0..N", minlen=1];
