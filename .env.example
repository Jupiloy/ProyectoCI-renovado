# Copiar a .env para desarrollo local. No guardar secretos reales en Git.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL=0

# B5.1 server-side opcional; BYOA no usa estas variables.
# Para la cola asíncrona, Compose pasa la configuración al servicio ai_worker.
TESISMCP_LLM_PROVIDER=DISABLED
TESISMCP_GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
TESISMCP_AI_WORKER_CONCURRENCY=1
TESISMCP_AI_WORKER_MAX_CONCURRENCY=4

# Zotero OAuth local. Registrar en Zotero el callback exacto indicado aquí.
ZOTERO_OAUTH_CLIENT_KEY=
ZOTERO_OAUTH_CLIENT_SECRET=
ZOTERO_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/zotero/callback
# Generar con Fernet.generate_key() y conservar la misma clave entre reinicios/backups.
ZOTERO_CREDENTIAL_ENCRYPTION_KEY=

# BYOA local: variables solo para el proceso run_byoa_connector; no las requiere ai_worker.
# Los dos tokens se muestran una vez al crear una conexión y nunca se deben commitear.
TESISMCP_API_BASE_URL=http://127.0.0.1:8000
TESISMCP_RUNTIME=ANTIGRAVITY_CLI
TESISMCP_RUNTIME_EXECUTABLE=
TESISMCP_RUNTIME_MODEL=
TESISMCP_RUNTIME_EFFORT=medium
TESISMCP_CONNECTOR_TOKEN=
TESISMCP_MCP_TOKEN=
